const languageSelect = document.getElementById("languageSelect");
const themeBtn = document.getElementById("themeBtn");
const printBtn = document.getElementById("printBtn");

function applyLanguage(lang){
  const dict = translations[lang] || translations.en;
  document.documentElement.lang = lang === "zh" ? "zh-Hant" : lang;
  document.querySelectorAll("[data-i18n]").forEach(el=>{
    const key = el.getAttribute("data-i18n");
    if(dict[key] !== undefined) el.textContent = dict[key];
  });

  const buttonLabels = {
    zh:["淡藍色","列印 / PDF"], en:["Light Blue","Print / PDF"],
    sv:["Ljusblå","Skriv ut / PDF"], es:["Azul claro","Imprimir / PDF"],
    vi:["Xanh nhạt","In / PDF"], ko:["라이트 블루","인쇄 / PDF"],
    ja:["ライトブルー","印刷 / PDF"], fr:["Bleu clair","Imprimer / PDF"]
  };
  const labels = buttonLabels[lang] || buttonLabels.en;
  themeBtn.textContent = document.body.dataset.theme === "deep" ? 
    (lang==="zh" ? "深藍色" : "Deep Blue") : labels[0];
  printBtn.textContent = labels[1];
  localStorage.setItem("resumeLang",lang);
}

languageSelect.addEventListener("change", e=>applyLanguage(e.target.value));

themeBtn.addEventListener("click", ()=>{
  const isDeep = document.body.dataset.theme === "deep";
  document.body.dataset.theme = isDeep ? "light" : "deep";
  localStorage.setItem("resumeTheme",document.body.dataset.theme);
  const lang = languageSelect.value;
  const lightLabels = {zh:"淡藍色",en:"Light Blue",sv:"Ljusblå",es:"Azul claro",vi:"Xanh nhạt",ko:"라이트 블루",ja:"ライトブルー",fr:"Bleu clair"};
  const deepLabels  = {zh:"深藍色",en:"Deep Blue",sv:"Mörkblå",es:"Azul profundo",vi:"Xanh đậm",ko:"딥 블루",ja:"ディープブルー",fr:"Bleu profond"};
  themeBtn.textContent = isDeep ? lightLabels[lang] : deepLabels[lang];
});

printBtn.addEventListener("click", ()=>window.print());

const savedLang = localStorage.getItem("resumeLang") || "zh";
const savedTheme = localStorage.getItem("resumeTheme") || "light";
document.body.dataset.theme = savedTheme;
languageSelect.value = savedLang;
applyLanguage(savedLang);
</script>
