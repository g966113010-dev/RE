  <style>
    :root{
      --bg:#edf7ff;
      --paper:#ffffff;
      --primary:#123f6d;
      --primary-2:#2f6fa8;
      --accent:#75b9e8;
      --soft:#dff1ff;
      --line:#c9e4f7;
      --text:#17324a;
      --muted:#647b8f;
      --shadow:0 20px 55px rgba(25,73,112,.15);
      --radius:24px;
    }
    [data-theme="deep"]{
      --bg:#e9f1f8;
      --paper:#ffffff;
      --primary:#0b2f53;
      --primary-2:#194f7c;
      --accent:#4e8fc2;
      --soft:#d7e7f4;
      --line:#bfd5e7;
      --text:#122b40;
      --muted:#61778a;
      --shadow:0 20px 55px rgba(10,47,83,.18);
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:Inter, "Noto Sans TC", "Noto Sans JP", "Noto Sans KR",
        "Microsoft JhengHei", "PingFang TC", "Yu Gothic", Arial, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(117,185,232,.25), transparent 28%),
        linear-gradient(135deg,var(--bg),#f9fcff 55%,var(--soft));
      color:var(--text);
      min-height:100vh;
    }

    .toolbar{
      position:sticky;
      top:0;
      z-index:20;
      backdrop-filter:blur(14px);
      background:rgba(255,255,255,.82);
      border-bottom:1px solid rgba(180,210,232,.65);
      padding:12px 18px;
    }

    .toolbar-inner{
      max-width:1180px;
      margin:auto;
      display:flex;
      gap:10px;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
    }

    .brand-mini{
      font-weight:800;
      color:var(--primary);
      letter-spacing:.03em;
      font-size:.95rem;
    }

    .controls{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      align-items:center;
    }

    select,button{
      border:1px solid var(--line);
      background:#fff;
      color:var(--primary);
      border-radius:999px;
      padding:9px 13px;
      font-weight:700;
      cursor:pointer;
      transition:.2s ease;
    }
    select:hover,button:hover{
      transform:translateY(-1px);
      box-shadow:0 7px 20px rgba(43,92,128,.12);
    }

    .page{
      max-width:1180px;
      margin:36px auto;
      padding:0 18px 40px;
    }

    .resume{
      background:var(--paper);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      overflow:hidden;
      display:grid;
      grid-template-columns:310px 1fr;
      min-height:900px;
      border:1px solid rgba(194,222,241,.75);
    }

    .sidebar{
      background:
        linear-gradient(165deg,var(--primary),var(--primary-2) 58%,#5fa9dc 145%);
      color:#fff;
      padding:42px 32px;
      position:relative;
    }
    .sidebar:after{
      content:"";
      position:absolute;
      width:190px;height:190px;
      border-radius:50%;
      border:30px solid rgba(255,255,255,.05);
      right:-95px;bottom:60px;
    }

    .monogram{
      width:92px;
      height:92px;
      border-radius:26px;
      display:grid;
      place-items:center;
      font-size:2rem;
      font-weight:900;
      letter-spacing:.05em;
      background:rgba(255,255,255,.15);
      border:1px solid rgba(255,255,255,.24);
      box-shadow:inset 0 0 30px rgba(255,255,255,.08);
      margin-bottom:22px;
    }

    .name{
      font-size:1.8rem;
      margin:0 0 7px;
      line-height:1.15;
    }
    .role{
      font-size:.96rem;
      line-height:1.55;
      color:#d9efff;
      margin:0 0 26px;
      font-weight:650;
    }

    .side-section{
      margin-top:28px;
      position:relative;
      z-index:2;
    }
    .side-section h3{
      font-size:.78rem;
      text-transform:uppercase;
      letter-spacing:.18em;
      color:#bfe7ff;
      margin:0 0 12px;
    }
    .contact-item,.lang-item{
      font-size:.86rem;
      line-height:1.65;
      margin:5px 0;
      color:#f6fbff;
    }

    .chips{
      display:flex;
      flex-wrap:wrap;
      gap:7px;
    }
    .chip{
      padding:6px 9px;
      border-radius:10px;
      background:rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.15);
      font-size:.76rem;
      line-height:1.2;
    }

    .main{
      padding:42px 48px 38px;
      background:
        linear-gradient(180deg,rgba(223,241,255,.35),transparent 220px),
        #fff;
    }

    .hero{
      border-bottom:1px solid var(--line);
      padding-bottom:22px;
      margin-bottom:24px;
    }
    .eyebrow{
      color:var(--primary-2);
      text-transform:uppercase;
      letter-spacing:.16em;
      font-size:.75rem;
      font-weight:900;
      margin-bottom:8px;
    }
    .headline{
      font-size:2.2rem;
      line-height:1.1;
      margin:0 0 13px;
      color:var(--primary);
      letter-spacing:-.03em;
    }
    .summary{
      font-size:.96rem;
      line-height:1.78;
      margin:0;
      color:#3b556d;
    }

    .section{
      margin-top:25px;
    }
    .section-title{
      display:flex;
      align-items:center;
      gap:10px;
      color:var(--primary);
      font-size:1rem;
      margin:0 0 13px;
      letter-spacing:.02em;
    }
    .section-title:after{
      content:"";
      height:1px;
      background:var(--line);
      flex:1;
    }

    .competency-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px 18px;
    }
    .competency{
      border-left:3px solid var(--accent);
      padding:8px 10px;
      background:linear-gradient(90deg,var(--soft),transparent);
      border-radius:0 10px 10px 0;
      font-size:.86rem;
      font-weight:700;
      color:#31506a;
    }

    .exp-card{
      padding:13px 0 15px;
      border-bottom:1px dashed var(--line);
    }
    .exp-card:last-child{border-bottom:none}
    .exp-top{
      display:flex;
      justify-content:space-between;
      gap:16px;
      align-items:flex-start;
      margin-bottom:4px;
    }
    .exp-title{
      font-weight:850;
      color:var(--primary);
      font-size:.94rem;
    }
    .exp-meta{
      font-size:.78rem;
      color:var(--muted);
      white-space:nowrap;
    }
    .exp-text{
      font-size:.86rem;
      line-height:1.62;
      color:#466179;
      margin:5px 0 0;
    }

    .footer-note{
      margin-top:28px;
      color:var(--muted);
      font-size:.74rem;
      text-align:right;
    }

    .hint{
      max-width:1180px;
      margin:0 auto 30px;
      padding:0 18px;
      color:#698198;
      font-size:.82rem;
    }

    @media (max-width:860px){
      .resume{grid-template-columns:1fr}
      .sidebar{padding:32px 28px}
      .main{padding:32px 28px}
      .competency-grid{grid-template-columns:1fr}
      .headline{font-size:1.85rem}
    }

    @media print{
      @page{size:A4;margin:0}
      body{background:#fff}
      .toolbar,.hint{display:none!important}
      .page{margin:0;padding:0;max-width:none}
      .resume{
        width:210mm;
        min-height:297mm;
        border-radius:0;
        box-shadow:none;
        border:none;
        grid-template-columns:59mm 1fr;
      }
      .sidebar{padding:18mm 8mm}
      .main{padding:16mm 11mm}
      .headline{font-size:24px}
      .summary,.exp-text{font-size:10.5px}
      .section{margin-top:14px}
      .section-title{margin-bottom:8px}
      .exp-card{padding:8px 0}
      .competency{padding:5px 8px;font-size:9.5px}
    }
  </style>
</head>

